#!/usr/bin/env bash
# Resumo da máquina de testes: vigilância da testnet e fuzzing. Correr com sudo.
echo "== Testnet (últimas 6 horas; hora UTC)"
column -s, -t < <(head -1 /var/lib/pqch-vigia/estado.csv 2>/dev/null; tail -6 /var/lib/pqch-vigia/estado.csv 2>/dev/null | grep -v '^hora_utc') 2>/dev/null || echo "ainda sem dados"
echo
echo "== Avisos da vigilância (últimas 24 h)"
journalctl -t pqch-vigia --since "24 hours ago" --no-pager -q | tail -10 || true
[[ -n "$(journalctl -t pqch-vigia --since '24 hours ago' -q 2>/dev/null)" ]] || echo "nenhum"
echo
echo "== Fuzzing"
echo "serviço: $(systemctl is-active pqch-fuzz)   commit compilado: $(cut -c1-9 /var/lib/pqch-fuzz/commit 2>/dev/null || echo '-')"
journalctl -u pqch-fuzz --no-pager -q -n 3 -o cat
n="$(find /var/lib/pqch-fuzz/falhas -type f 2>/dev/null | wc -l)"
echo "entradas com falha guardadas: $n"
[[ "$n" == 0 ]] || { echo "ATENÇÃO: há falhas para analisar em /var/lib/pqch-fuzz/falhas:"; ls -1 /var/lib/pqch-fuzz/falhas | head -20; }
